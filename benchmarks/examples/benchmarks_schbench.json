{
  "$schema": "https://arma4os.org/schemas/benchmarks-v1.json",
  "schema_version": 1,
  "description": "ARMA4OS optional schbench latency benchmark example",
  "policies": [
    "default"
  ],
  "timeout_sec": 45.0,
  "warmup": 0,
  "workloads": [
    {
      "name": "schbench_wakeup_latency",
      "command": [
        "schbench",
        "-m",
        "2",
        "-t",
        "2",
        "-s",
        "10000",
        "-c",
        "10000",
        "-r",
        "10"
      ],
      "parser": "schbench",
      "timeout_sec": 30.0,
      "warmup": 0,
      "metadata": {
        "description": "schbench wake latency benchmark measuring wakeup percentiles",
        "category": "latency_microbenchmark"
      }
    }
  ]
}
